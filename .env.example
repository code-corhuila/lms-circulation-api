# Every variable this service reads (internal/config/config.go). No real values —
# rules/2-anexos/I-github-common.md.

PORT=8080

# Points at MongoDB (loan_db), not PostgreSQL — ADR-005-mongodb-for-circulation-service.md.
DB_HOST=localhost
DB_PORT=27017
DB_USER=lms_user
DB_PASSWORD=lms_password
DB_NAME=loan_db

# Public half of lms-access-api's signing key (JWT_PRIVATE_KEY there) — never
# the private key itself. Paste as one line with literal \n.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAmbNi1GoOVrL1Iq7e0vSH\nDVfxUnP3UB/ibjQXEv1xmhNCihKuZidRwam8xp1xVTzgh/J0lOajGPBUDsTMW2Ti\nGdmcCrbvAQ5YqTI2Dfxun02dKwIA/fHaLKzHdgCfddOasgkEFl1xj5xVMnYcUM7s\nFz/N7ENf2aR97FtrDZ1a3vDvy0G6l5qCIrWutnEJYvjQjSagWPXkXGawZpibLC/b\na6vesi3k5Nh3xdX7+ipoTIOGeyLbBSjMO/n3t1KVzP4oZgKWsZkIJVEny2PdODb7\nG192K1WwL7/WAt/Z2swWN12rGTRiDI86H90QWnK+iH/umvGuOna5nVSljzIlZYFP\nBwIDAQAB\n-----END PUBLIC KEY-----\n
# Separate from the RS256 key above, on purpose (internal/config/config.go).
# This service both mints it (calling membership-api/catalog-api) and
# validates it (incoming calls) — must match INTERNAL_JWT_SECRET on both of
# those services too.
INTERNAL_JWT_SECRET=change-me-internal-secret
JWT_EXPIRY=1h

LOG_LEVEL=info
CORS_ORIGIN=*

MEMBERSHIP_SERVICE_URL=http://membership-service:8080
CATALOG_SERVICE_URL=http://catalog-service:8080
